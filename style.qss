/* ===== 全局样式 style.qss =====
 * 说明: 与各 .ui 里控件内联样式互补, 内联样式优先级更高, 不会覆盖设计器里已设的样式。
 * 主题基准来自 MyWindow.ui: 白底 + 浅蓝灰文字 rgb(106,150,186) + 灰色圆角按钮。
 * 此文件只影响"未单独设置样式"的控件, 放大/调色可直接在此处修改。
 */

* {
    font-family: "Microsoft YaHei"; /* 中文更清晰; 各控件内联 Arial 仍优先 */
}

QToolTip {
    background-color: #2b3a4a;
    color: #ffffff;
    border: 1px solid #1b2838;
    border-radius: 4px;
    padding: 4px 8px;
}

/* 弹窗: 一致性(GUI线程 QMessageBox 用) */
QMessageBox {
    background-color: #ffffff;
    border: 1px solid #c8d6e0;
}
QMessageBox QPushButton {
    background-color: #ebebeb;
    border: 1px solid #b9c6d0;
    border-radius: 8px;
    padding: 6px 20px;
    min-width: 72px;
    color: #2b3a4a;
}
QMessageBox QPushButton:hover {
    background-color: #6a96ba;
    color: #ffffff;
}

/* 滚动条: 细窄 + 悬浮变深 */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0;
}
QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 0;
}
QScrollBar::handle:vertical,
QScrollBar::handle:horizontal {
    background: #9fb6c9;
    border-radius: 5px;
    min-height: 30px;
    min-width: 30px;
}
QScrollBar::handle:vertical:hover,
QScrollBar::handle:horizontal:hover {
    background: #6a96ba;
}
QScrollBar::add-line, QScrollBar::sub-line {
    width: 0;
    height: 0;
}
QScrollBar::add-page, QScrollBar::sub-page {
    background: transparent;
}

/* 输入控件: 统一圆角边框, 聚焦高亮 */
QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    border: 1px solid #c8d6e0;
    border-radius: 6px;
    padding: 2px 6px;
    background-color: #ffffff;
    selection-background-color: #6a96ba;
}
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
    border: 2px solid #6a96ba;
}
QComboBox::drop-down {
    border: none;
    width: 22px;
}
QComboBox QAbstractItemView {
    border: 1px solid #c8d6e0;
    border-radius: 6px;
    selection-background-color: #6a96ba;
    selection-color: #ffffff;
}

/* 进度条: 与主题蓝色一致 */
QProgressBar {
    border: 1px solid #c8d6e0;
    border-radius: 8px;
    background-color: #f0f4f7;
    text-align: center;
    color: #2b3a4a;
}
QProgressBar::chunk {
    background-color: #6a96ba;
    border-radius: 8px;
}

/* 复选框/单选: 统一尺寸(便于触屏点击) */
QCheckBox::indicator, QRadioButton::indicator {
    width: 18px;
    height: 18px;
}

/* 状态栏: 与顶部白/浅蓝一致 */
QStatusBar {
    background-color: #ffffff;
    border-top: 1px solid #c8d6e0;
}